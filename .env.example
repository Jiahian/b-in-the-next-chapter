# Copy the value below into a local config.js (gitignored, see index.html)
# for local testing:
#
#   window.WEB_APP_URL = "https://script.google.com/macros/s/.../exec";
#
# For the hosted GitHub Pages build, this is never read from a file — it's
# injected at deploy time from the WEB_APP_URL repository secret
# (Settings > Secrets and variables > Actions), so it never touches git
# history. See .github/workflows/deploy.yml.
WEB_APP_URL=https://script.google.com/macros/s/PASTE_YOUR_DEPLOYMENT_ID/exec
