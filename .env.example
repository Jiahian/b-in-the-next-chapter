# Copy the values below into a local config.js (gitignored, see index.html)
# for local testing:
#
#   window.WEB_APP_URL = "https://script.google.com/macros/s/.../exec";
#   window.SITE_PASSWORD = "...";
#
# For the hosted GitHub Pages build, these are never read from a file —
# they're injected at deploy time from the WEB_APP_URL/SITE_PASSWORD
# repository secrets (Settings > Secrets and variables > Actions), so
# neither touches git history. See .github/workflows/deploy.yml.
#
# SITE_PASSWORD is a client-side gate only, not real authentication — it
# ships in plain text to every visitor's browser. It stops casual
# visitors, not a determined one. Leave it blank/unset to disable the gate.
WEB_APP_URL=https://script.google.com/macros/s/PASTE_YOUR_DEPLOYMENT_ID/exec
SITE_PASSWORD=PASTE_YOUR_CHOSEN_PASSWORD
